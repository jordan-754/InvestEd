<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- AUTH SCREENS -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.InvestEd.ui.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.InvestEd.ui.register.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <argument
            android:name="isGoogleSignUp"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="firstName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="lastName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="email"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_registerFragment_to_createPasswordFragment"
            app:destination="@id/createPasswordFragment" />
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/createPasswordFragment"
        android:name="com.example.InvestEd.ui.register.CreatePasswordFragment"
        android:label="Create Password"
        tools:layout="@layout/fragment_create_password">
        <argument
            android:name="firstName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="lastName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="email"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="birthdate"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="school"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="place"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_createPasswordFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/otpSendFragment"
        android:name="com.example.InvestEd.ui.otp.OtpSendFragment"
        android:label="OTP Send"
        tools:layout="@layout/fragment_otp_send">
        <argument
            android:name="email"
            app:argType="string" />
        <action
            android:id="@+id/action_otpSendFragment_to_otpVerifyFragment"
            app:destination="@id/otpVerifyFragment" />
    </fragment>

    <fragment
        android:id="@+id/otpVerifyFragment"
        android:name="com.example.InvestEd.ui.otp.OtpVerifyFragment"
        android:label="OTP Verify"
        tools:layout="@layout/fragment_otp_verify">
        <argument
            android:name="email"
            app:argType="string" />
        <argument
            android:name="username"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="accountId"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_otpVerifyFragment_to_successFragment"
            app:destination="@id/successFragment" />
    </fragment>

    <fragment
        android:id="@+id/successFragment"
        android:name="com.example.InvestEd.ui.success.SuccessFragment"
        android:label="Success"
        tools:layout="@layout/fragment_success">
        <argument
            android:name="username"
            app:argType="string" />
        <argument
            android:name="accountId"
            app:argType="string" />
        <action
            android:id="@+id/action_successFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- MAIN / BOTTOM NAV SCREENS -->
    <fragment
        android:id="@+id/notificationFragment"
        android:name="com.example.InvestEd.ui.notification.NotificationFragment"
        android:label="Notifications" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.InvestEd.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/microInvestmentFragment"
        android:name="com.example.InvestEd.ui.microinvestment.MicroInvestmentFragment"
        android:label="Invest"
        tools:layout="@layout/fragment_micro_investment" />

    <fragment
        android:id="@+id/goalsFragment"
        android:name="com.example.InvestEd.ui.goals.GoalsFragment"
        android:label="Goals"
        tools:layout="@layout/fragment_goals" />

    <fragment
        android:id="@+id/budgetFragment"
        android:name="com.example.InvestEd.ui.budget.BudgetFragment"
        android:label="Budget"
        tools:layout="@layout/fragment_budget" />

    <fragment
        android:id="@+id/learningFragment"
        android:name="com.example.InvestEd.ui.learning.LearningFragment"
        android:label="Learn"
        tools:layout="@layout/fragment_learning">
        <action
            android:id="@+id/action_learningFragment_to_lessonDetailFragment"
            app:destination="@id/lessonDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/lessonDetailFragment"
        android:name="com.example.InvestEd.ui.learning.LessonDetailFragment"
        android:label="Lesson Detail"
        tools:layout="@layout/fragment_lesson_detail" />

    <!-- HIDDEN SCREENS (no bottom nav) -->
    <fragment
        android:id="@+id/aiChatFragment"
        android:name="com.example.InvestEd.ui.ai.AiChatFragment"
        android:label="AI Chat"
        tools:layout="@layout/fragment_ai_chat" />

    <fragment
        android:id="@+id/rewardsFragment"
        android:name="com.example.InvestEd.ui.rewards.RewardsFragment"
        android:label="Rewards"
        tools:layout="@layout/fragment_rewards" />

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.example.InvestEd.ui.account.AccountFragment"
        android:label="Account"
        tools:layout="@layout/fragment_account">
        <action
            android:id="@+id/action_accountFragment_to_personalDetailsFragment"
            app:destination="@id/personalDetailsFragment" />
        <action
            android:id="@+id/action_accountFragment_to_transactionHistoryFragment"
            app:destination="@id/transactionHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/transactionHistoryFragment"
        android:name="com.example.InvestEd.ui.account.TransactionHistoryFragment"
        android:label="Transaction History"
        tools:layout="@layout/fragment_transaction_history" />

    <fragment
        android:id="@+id/personalDetailsFragment"
        android:name="com.example.InvestEd.ui.personaldetails.PersonalDetailsFragment"
        android:label="Personal Details"
        tools:layout="@layout/fragment_personal_details" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.InvestEd.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.example.InvestEd.ui.settings.ChangePasswordFragment"
        android:label="Change Password"
        tools:layout="@layout/fragment_change_password" />

</navigation>